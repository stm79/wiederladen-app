# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (SQLite db + uploaded images)
/data/db/*
/data/uploads/*
!/data/db/.gitkeep
!/data/uploads/.gitkeep

# personal raw chrono export files (real shooting data) — only the small,
# de-identified copies under test/fixtures/chrono are meant to be tracked
/chrono/

# stray screenshots/phone photos dropped in the project root during manual
# testing — not app source, shouldn't be committed
/*.jpg
/*.jpeg
/*.png
